# =============================================================================
# Open Vox X2 — 环境变量模板
# 复制成 .env 后按需修改；systemd unit 里用 EnvironmentFile= 引用即可。
# 必填项只有 3 个：VOX_LLM_URL / VOX_TTS_BACKEND(或 cosyvoice 地址) / VOX_TOKEN(公网才需要)
# =============================================================================

# ---------------------------------------------------------------------------
# [必填核心] 服务端口 / 数据 / 大模型
# ---------------------------------------------------------------------------
VOX_HOST=0.0.0.0
VOX_PORT=8766
# 单库：对话历史 + 视觉索引 + 待办 + 记忆，一个 sqlite 文件搞定
VOX_DB=./data/vox_unified.db
VOX_FRAME_DIR=/dev/shm/vox-frames

# 任何 OpenAI 兼容 /v1/chat/completions（vLLM / Ollama / llama.cpp / DeepSeek / OpenAI）
VOX_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
VOX_LLM_MODEL=qwen2.5-7b-instruct
VOX_LLM_API_KEY=sk-local
VOX_LLM_TIMEOUT_S=60
VOX_LLM_TEMP=0.35

# 留空 = 不注入 reasoning_effort / max_thinking_tokens（标准 OpenAI 协议开箱即用）
# 只有跑支持该字段的推理框架（如 Halogen / vLLM reasoning 插件）时才填 low|medium|high|none
VOX_LLM_REASONING_EFFORT=
VOX_LLM_MAX_THINKING=128

# 人设：留空用内置通用人设；填文件路径可完全自定义（纯文本，可写任意角色设定）
VOX_PERSONA_FILE=

# ---------------------------------------------------------------------------
# [必填核心] TTS 后端：cosyvoice（本地 2080Ti 级）| openai（任意 /v1/audio/speech）
# ---------------------------------------------------------------------------
VOX_TTS_BACKEND=cosyvoice
# --- 本地 CosyVoice2 ---
VOX_CV_TTS_URL=http://127.0.0.1:50002
VOX_CV_SPK_ID=default
VOX_CV_TTS_PATH=/inference_spk
# --- 任意 OpenAI 兼容语音合成（没有本地显卡时用这条）---
# 例：https://api.openai.com/v1  或  http://127.0.0.1:9880/v1 （GPT-SoVITS-API）
VOX_TTS_OPENAI_URL=
VOX_TTS_OPENAI_KEY=
VOX_TTS_OPENAI_MODEL=tts-1
VOX_TTS_OPENAI_VOICE=alloy

# （可选）GPT-SoVITS 自建
VOX_TTS_ENGINE=cosyvoice
VOX_GSV_URL=
VOX_GSV_REF=
VOX_GSV_PROMPT=

# ---------------------------------------------------------------------------
# [可选 · 双脑与延迟] 前台快脑 + 后台工兵 + 择机插话
# ---------------------------------------------------------------------------
# 1 = 开启双脑（前台秒答 + 后台干活 + 静默窗插话）
VOX_DUPLEX_DUAL_BRAIN=0
# 两次主动播报最小间隔（秒）
VOX_PROACTIVE_COOLDOWN_S=90
# 主动播报原文去重窗口（秒）与相似度阈值（写在代码里，一般不用改）
VOX_PROACTIVE_DEDUP_S=600
# 后台结果插话前的静默门限（秒）
VOX_INTERJECT_SILENCE_S=1.8
# 1 = 轻附和词（嗯/哈哈/哦）不打断正在播报的回复
VOX_BACKCHANNEL_GUARD=0
# 1 = 走流式 SSE（首包更快）；0 = 一次性返回
VOX_LLM_STREAM=1
# 1 = 预取下一句 TTS（单卡并发会互相抢占，默认关）
VOX_TTS_PREFETCH=0

# ---------------------------------------------------------------------------
# [可选 · 声纹 / 访客模式]
# ---------------------------------------------------------------------------
# 1 = 允许「声纹+音量」自动切访客；0 = 只认口令（推荐 0，避免其他人说话大声误切）
VOX_AUTO_GUEST=0
VOX_OWNER_NEAR_RMS=800
# 旁人与环境音分流：声纹低于此值的「旁人」语音只入库、不触发对话
VOX_BYSTANDER_MIN_REPLY_SIM=0.25

# 声纹库路径（enroll 后生成，务必不要提交）
VOX_VOICEPRINT_FILE=./data/voiceprints.json
# 唤醒词（逗号分隔，SLEEP_LISTEN 模式生效）
VOX_WAKE_WORDS=vox

# ---------------------------------------------------------------------------
# [可选 · Home Assistant]
# ---------------------------------------------------------------------------
VOX_HA_URL=
VOX_HA_TOKEN=
# 门锁/安防域永远硬拦截，不受此处配置影响

# ---------------------------------------------------------------------------
# [可选 · 高德地图 / 导航]
# ---------------------------------------------------------------------------
AMAP_API_KEY=
VOX_DEFAULT_CITY=Shanghai

# ---------------------------------------------------------------------------
# [可选 · 车载 HUD / OBD]
# ---------------------------------------------------------------------------
# 树莓派 10Hz OBD UDP 广播端口（extras/obd-udp）
OBD_UDP_PORT=18766
# 车机 Wi-Fi SSID：连上即自动切驾驶 HUD（留空=不自动切）
VOX_DRIVE_SSID=

# ---------------------------------------------------------------------------
# [可选 · 安全]
# ---------------------------------------------------------------------------
# 公网暴露必须设置；客户端用 X-Vox-Token 头带上同一个值
VOX_TOKEN=
# 1 = 播报期间忽略上行音频（硬件 AEC 未调好时的保险丝）
VOX_HALF_DUPLEX_GUARD=1
